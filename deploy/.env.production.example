# ===== Trade Master 生产 .env 模板（复制到服务器 /root/trade-master/.env 使用）=====
# 注意：docker-compose 的 env_file 要求 KEY=value（不要 export 前缀）

# --- 大模型（DeepSeek）：从本地 .env 复制 ---
DEEPSEEK_API_KEY=sk-xxxx
OPENAI_API_KEY=sk-xxxx

# --- 行情（Wind）：从本地 .env 复制 ---
WIND_API_KEY=ak-xxxx

# --- 阿里云百炼 DashScope（持仓截图识别）：从本地 .env 复制 ---
DASHSCOPE_API_KEY=sk-ws-xxxx
DASHSCOPE_BASE_URL=https://xxx.maas.aliyuncs.com/api/v1
DASHSCOPE_VL_MODEL=qwen3-vl-flash

# --- 阿里云短信（先不接，可留空；缺配置时登录走「开发模式验证码」打印到日志）---
# ALIYUN_ACCESS_KEY_ID=xxxx
# ALIYUN_ACCESS_KEY_SECRET=xxxx
# SMS_SIGN_NAME=xxxx
# SMS_TEMPLATE_CODE=SMS_xxxx

# --- 数据库 ---
# DB_PASSWORD 供 docker-compose 的 postgres 容器使用；须与下面 DATABASE_URL 里的密码一致
DB_PASSWORD=请生成一个强随机密码
DATABASE_URL=postgresql+psycopg://trade_master:请填入与DB_PASSWORD相同的密码@db:5432/trade_master
