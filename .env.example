# ===== Trade Master · 模拟交易 + AI 托管 环境变量模板（复制为 .env 使用）=====

# --- 大模型（DeepSeek）---
export DEEPSEEK_API_KEY=sk-xxxx
export OPENAI_API_KEY=sk-xxxx          # 引擎用（与 DEEPSEEK_API_KEY 同值即可）
# export DEEPSEEK_MODEL=deepseek-v4-pro
# export DEEPSEEK_QUICK_MODEL=deepseek-v4-flash
# export DEEPSEEK_MAX_TOKENS=8000

# --- 行情（Wind MCP）---
# Wind key 优先读环境变量，其次 ~/.wind-aifinmarket/config
# export WIND_API_KEY=ak_xxxx

# --- 数据库（PostgreSQL）---
# psycopg3 连接串；部署时改成真实库
export DATABASE_URL=postgresql+psycopg://trade_master:trade_master@localhost:5432/trade_master

# --- 阿里云短信（未配置时验证码打印到服务端日志，开发兜底）---
export ALIYUN_ACCESS_KEY_ID=xxxx
export ALIYUN_ACCESS_KEY_SECRET=xxxx
export SMS_SIGN_NAME=xxxx
export SMS_TEMPLATE_CODE=SMS_xxxx

# --- 阿里云百炼（DashScope）持仓截图识别 ---
# 图片 → qwen3-vl 视觉模型直接抽结构化持仓，无需单独开通"阿里云 OCR 服务"。
# DASHSCOPE_BASE_URL 为百炼工作空间原生端点（.../api/v1）；若用 OpenAI 兼容端点需另行适配。
export DASHSCOPE_API_KEY=sk-ws-xxxx
export DASHSCOPE_BASE_URL=https://xxx.maas.aliyuncs.com/api/v1
export DASHSCOPE_VL_MODEL=qwen3-vl-flash

# --- 行情缓存库路径（默认 data/market_cache.sqlite）---
# export MARKET_CACHE_PATH=...

# --- 部署（deploy/deploy.sh 读它；生产机地址不写死在脚本里）---
export DEPLOY_HOST=<生产机地址>
